# For multi-tenant deployments, set a unique COMPOSE_PROJECT_NAME, SERVICE_NAME,
# REDIS_NAMESPACE and published host port for each tenant directory.
# REGISTRY_IMAGE must point to a prebuilt published image.
# Copy to .env and replace all example credentials before deployment.
# This is an example configuration, not a production secret file.
#
# DOCKER / IMAGE
COMPOSE_PROJECT_NAME=tenant-example
REGISTRY_IMAGE=registry.example.internal/team/skelton-monorepo-starter
IMAGE_TAG=1.0.0  # replace with an existing immutable registry release tag
APP_BIND_HOST=127.0.0.1
APP_PUBLISHED_PORT=3000
# Per-tenant container resource limits (adjust after profiling)
APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=1.0
APP_PIDS_LIMIT=256
WORKER_MEMORY_LIMIT=256m
WORKER_CPU_LIMIT=0.5
WORKER_PIDS_LIMIT=128
SCHEDULER_MEMORY_LIMIT=256m
SCHEDULER_CPU_LIMIT=0.5
SCHEDULER_PIDS_LIMIT=128
# Internal container ports are fixed (web 3000, API 3001).
# APP_BIND_HOST=0.0.0.0 exposes the published port on all host interfaces.

# RUNTIME
APP_ENV=development
SERVICE_NAME=tenant-example
TZ=UTC
LOG_LEVEL=info
AUTO_MIGRATE=false
AUTO_SEED=false
EXAMPLE_ROUTES_ENABLED=true
API_TIMEOUT_MS=10000
SERVER_IDLE_TIMEOUT_SECONDS=15
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=15000
SHUTDOWN_DRAIN_DELAY_MS=1000
SECURITY_HEADERS_ENABLED=true
OUTBOUND_HTTP_TIMEOUT_MS=5000
OUTBOUND_HTTP_MAX_RETRIES=2
OUTBOUND_HTTP_RETRY_BASE_MS=100
# WEB: Same-origin routing, don't set API_PROXY_TARGET or API_BASE_URL externally.
PUBLIC_API_BASE_URL=/api
# Local development only: web :5173 proxies requests to API :3001.
API_PROXY_TARGET=http://127.0.0.1:3001
API_BASE_URL=http://127.0.0.1:3001/api

# EXTERNAL MYSQL 8 (never run a local DB container from this stack)
DB_DRIVER=mysql
DATABASE_URL=mysql://app_user:replace-me@mysql.example.internal:3306/app_db
# Optional dedicated migration credentials. If blank, API falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_SECONDS=30
DB_CONNECTION_TIMEOUT_SECONDS=10
DB_MAX_LIFETIME_SECONDS=0
DB_PREPARE=true
# Staging/production must use verify-full, with appropriate CA trust.
DB_TLS_MODE=disable
DB_TLS_CA_FILE=
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# EXTERNAL REDIS (worker/scheduler profiles only)
REDIS_URL=redis://:replace-me@redis.example.internal:6379/0
REDIS_NAMESPACE=tenant-example:development
REDIS_CONNECTION_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=20
WORKER_QUEUE_NAME=default
WORKER_CONCURRENCY=1
WORKER_BLOCK_MS=1000
WORKER_JOB_TIMEOUT_MS=30000
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_MS=1000
WORKER_STALE_AFTER_MS=60000
WORKER_RECLAIM_INTERVAL_MS=15000
SCHEDULER_TIMEZONE=Asia/Jakarta

# Observability; enable metrics only with a valid secret token (>=24 characters).
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
METRICS_TOKEN=
PROCESS_HEALTH_PORT=9465
