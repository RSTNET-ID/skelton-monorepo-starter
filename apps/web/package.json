{
	"name": "@rstnet-id/svelte-skeleton",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=22.17.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun ./build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"ci": "bun run check:components && bun run check && bun run lint && bun run format:check && bun run test:unit && bun run --bun build",
		"check:components": "bun scripts/check-base-components.ts",
		"make:module": "bun scripts/make-module.ts"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.4",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"autonumeric": "4.10.10",
		"flatpickr": "4.6.13",
		"@lucide/svelte": "1.53.0"
	}
}
