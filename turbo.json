{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        "build/**",
        ".svelte-kit/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "test": {
      "outputs": [
        "coverage/**"
      ]
    },
    "test:unit": {
      "outputs": [
        "coverage/**"
      ]
    },
    "ci": {
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "dev:monorepo": {
      "cache": false,
      "persistent": true
    }
  }
}
